{
  "name": "bbb-plugin-smart-slide-link",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.tsx",
  "dependencies": {
    "bigbluebutton-html-plugin-sdk": "1.0.0-beta.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "12.1.7"
  },
  "scripts": {
    "build-bundle": "webpack --mode production",
    "start": "webpack serve --mode development",
    "build:watch": "rm -rf dist && tsc -w --module CommonJS",
    "lint": "eslint --ext .ts,.tsx,.mjs ./src ./tests",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test": "npx playwright test",
    "test:isolated": "TEST_MEETINGS=isolated npx playwright test",
    "test-chromium-ci": "export CI='true' && npx playwright test --project=chromium",
    "publish-plugin:dev": "bash scripts/copy-plugin-to-container.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "31.0.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.6"
  }
}
