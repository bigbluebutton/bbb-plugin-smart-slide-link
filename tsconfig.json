{
    "compilerOptions": {
        "outDir": "./dist-tsc/",
        "noImplicitAny": true,
        "strictNullChecks": true,
        "module": "esnext",
        "target": "es2017",
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "types": ["node"],
        "rootDir": "./src"
    },
    "include": ["src/*"],
    "paths": {
        "*": ["node_modules"]
    },
    "exclude": [
        "node_modules"
    ]
}
